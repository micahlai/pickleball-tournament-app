# Optional future M2 configuration. Leave both blank for the M1 shell.
# Copy this file to .env.local, which must remain untracked.
# Use the Supabase project URL and a PUBLIC publishable key only.
# Never place secret or service-role keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
